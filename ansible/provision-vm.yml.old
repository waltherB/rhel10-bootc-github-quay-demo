---
# Provision a RHEL 10 bootc VM on OpenShift Virtualization (KubeVirt).
#
# Prerequisites on your Mac:
#   pip install ansible kubernetes
#   ansible-galaxy collection install -r ansible/requirements.yml
#   oc login https://api.your-cluster.example.com --token=<token>
#
# Run:
#   ansible-playbook ansible/provision-vm.yml
#
# Variables (override on CLI with -e or edit defaults below):
#   quay_image   - bootc image to pull  (default: quay.io/waba/bootc-guide:prod)
#   vm_name      - VM object name       (default: rhel10-bootc-demo)
#   vm_namespace - target namespace     (default: bootc-vms)
#   ssh_pub_key  - SSH public key injected via cloud-init

- name: Provision RHEL 10 bootc VM on OpenShift Virtualization
  hosts: localhost
  connection: local
  gather_facts: false

  vars:
    quay_image: "quay.io/waba/bootc-guide:prod"
    vm_name: "rhel10-bootc-demo"
    vm_namespace: "bootc-vms"
    vm_cores: 2
    vm_memory: "2Gi"
    vm_disk_size: "30Gi"
    vm_storage_class: "lvms-vg1"
    ssh_pub_key: "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"

  tasks:
    - name: Ensure namespace exists with required pod-security labels
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: v1
          kind: Namespace
          metadata:
            name: "{{ vm_namespace }}"
            labels:
              pod-security.kubernetes.io/enforce: privileged
              pod-security.kubernetes.io/audit: privileged
              pod-security.kubernetes.io/warn: privileged

    - name: Read local docker config for Quay auth
      set_fact:
        docker_config: "{{ lookup('file', '~/.docker/config.json') | from_json }}"

    - name: Parse Quay credentials
      set_fact:
        quay_auth: "{{ (docker_config.auths['quay.io'].auth | default(docker_config.auths['https://quay.io'].auth) | b64decode).split(':', 1) }}"
      no_log: true

    - name: Create Quay pull secret for CDI
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: v1
          kind: Secret
          metadata:
            name: quay-pull-secret
            namespace: "{{ vm_namespace }}"
          type: Opaque
          data:
            accessKeyId: "{{ quay_auth[0] | b64encode }}"
            secretKey: "{{ quay_auth[1] | b64encode }}"

    - name: Create ServiceAccount for VM pod
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: v1
          kind: ServiceAccount
          metadata:
            name: bootc-vm-sa
            namespace: "{{ vm_namespace }}"

    - name: Create RBAC Role for VM SA
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: rbac.authorization.k8s.io/v1
          kind: Role
          metadata:
            name: bootc-vm-role
            namespace: "{{ vm_namespace }}"
          rules:
            - apiGroups: [""]
              resources: ["persistentvolumeclaims"]
              verbs: ["get", "list", "watch"]
            - apiGroups: ["cdi.kubevirt.io"]
              resources: ["datavolumes"]
              verbs: ["get", "list", "watch"]
            - apiGroups: ["subresources.kubevirt.io"]
              resources: ["virtualmachineinstances/console", "virtualmachineinstances/vnc", "virtualmachineinstances/ssh"]
              verbs: ["get", "update"]

    - name: Bind RBAC Role to VM SA
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: rbac.authorization.k8s.io/v1
          kind: RoleBinding
          metadata:
            name: bootc-vm-rolebinding
            namespace: "{{ vm_namespace }}"
          subjects:
            - kind: ServiceAccount
              name: bootc-vm-sa
              namespace: "{{ vm_namespace }}"
          roleRef:
            kind: Role
            name: bootc-vm-role
            apiGroup: rbac.authorization.k8s.io

    - name: Allow CDI importer to pull from Quay (image-puller on default SA)
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: rbac.authorization.k8s.io/v1
          kind: RoleBinding
          metadata:
            name: cdi-importer-pull-secret
            namespace: "{{ vm_namespace }}"
          subjects:
            - kind: ServiceAccount
              name: default
              namespace: "{{ vm_namespace }}"
          roleRef:
            kind: ClusterRole
            name: system:image-puller
            apiGroup: rbac.authorization.k8s.io

    - name: Deploy VirtualMachine
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: kubevirt.io/v1
          kind: VirtualMachine
          metadata:
            name: "{{ vm_name }}"
            namespace: "{{ vm_namespace }}"
            labels:
              app: "{{ vm_name }}"
          spec:
            running: true
            template:
              metadata:
                labels:
                  kubevirt.io/vm: "{{ vm_name }}"
              spec:
                serviceAccountName: bootc-vm-sa
                domain:
                  cpu:
                    cores: "{{ vm_cores }}"
                  memory:
                    guest: "{{ vm_memory }}"
                  devices:
                    disks:
                      - name: bootdisk
                        disk:
                          bus: virtio
                        bootOrder: 1
                      - name: cloudinit
                        disk:
                          bus: virtio
                    interfaces:
                      - name: default
                        masquerade: {}
                networks:
                  - name: default
                    pod: {}
                volumes:
                  - name: bootdisk
                    dataVolume:
                      name: "{{ vm_name }}-dv"
                  - name: cloudinit
                    cloudInitNoCloud:
                      userData: |
                        #cloud-config
                        hostname: {{ vm_name }}
                        ssh_authorized_keys:
                          - {{ ssh_pub_key }}
            dataVolumeTemplates:
              - metadata:
                  name: "{{ vm_name }}-dv"
                spec:
                  pvc:
                    storageClassName: "{{ vm_storage_class }}"
                    accessModes:
                      - ReadWriteOnce
                    resources:
                      requests:
                        storage: "{{ vm_disk_size }}"
                  source:
                    # registry source: CDI pulls the bootc OCI image and uses
                    # it as the VM disk. bootc images are valid disk images in
                    # OCI format so this produces a bootable volume.
                    # pullMethod: node uses the node's CRI to pull (faster than pod).
                    registry:
                      url: "docker://{{ quay_image }}"
                      secretRef: quay-pull-secret
                      pullMethod: node

    - name: Wait for VM to be ready
      kubernetes.core.k8s_info:
        api_version: kubevirt.io/v1
        kind: VirtualMachineInstance
        name: "{{ vm_name }}"
        namespace: "{{ vm_namespace }}"
      register: vmi
      until: >
        vmi.resources | length > 0 and
        vmi.resources[0].status.phase == "Running"
      retries: 30
      delay: 10

    - name: Show VM IP
      debug:
        msg: >
          VM {{ vm_name }} is running.
          IP: {{ vmi.resources[0].status.interfaces[0].ipAddress | default('pending') }}
          SSH: ssh demo@{{ vmi.resources[0].status.interfaces[0].ipAddress | default('pending') }}
